cmake_minimum_required(VERSION 3.21)

file(MAKE_DIRECTORY "${WORK_DIR}")

function(run_cli expected_exit expected_probes)
    file(REMOVE "${WORK_DIR}/probes.txt" "${WORK_DIR}/summary.json" "${WORK_DIR}/summary.csv")
    execute_process(
        COMMAND "${CLI}" ${ARGN} --no-color
        WORKING_DIRECTORY "${WORK_DIR}"
        RESULT_VARIABLE status
        OUTPUT_VARIABLE console
        ERROR_VARIABLE errors
        TIMEOUT 5)
    if(NOT status STREQUAL "${expected_exit}")
        message(FATAL_ERROR "Expected exit ${expected_exit}, got ${status}\nstdout: ${console}\nstderr: ${errors}")
    endif()

    set(probes)
    if(EXISTS "${WORK_DIR}/probes.txt")
        file(STRINGS "${WORK_DIR}/probes.txt" probes)
    endif()
    list(LENGTH probes probe_count)
    if(NOT probe_count EQUAL expected_probes)
        message(FATAL_ERROR "Expected ${expected_probes} probes, got ${probe_count}\nstdout: ${console}\nstderr: ${errors}")
    endif()

    set(console "${console}" PARENT_SCOPE)
    set(errors "${errors}" PARENT_SCOPE)
endfunction()

function(expect_text output expected)
    string(FIND "${output}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Expected '${expected}' in:\n${output}")
    endif()
endfunction()

function(reject_text output unexpected)
    string(FIND "${output}" "${unexpected}" position)
    if(NOT position EQUAL -1)
        message(FATAL_ERROR "Unexpected '${unexpected}' in:\n${output}")
    endif()
endfunction()

function(expect_json expected)
    string(JSON actual GET "${json}" ${ARGN})
    if(NOT actual STREQUAL "${expected}")
        message(FATAL_ERROR "JSON field ${ARGN}: expected '${expected}', got '${actual}'\n${json}")
    endif()
endfunction()

if(CASE STREQUAL "default_probe")
    run_cli(0 1 192.0.2.4)
    expect_text("${console}" "RTT=0ms TTL=63")
elseif(CASE STREQUAL "mixed_json")
    run_cli(0 3 192.0.2.1 -c 3 --summary --json summary.json)
    expect_text("${console}" "3 attempts, 2 replies, 33% without reply")
    expect_text("${console}" "10/20/30/20/10/20 ms")
    reject_text("${console}" "Attempt 1")
    file(READ "${WORK_DIR}/summary.json" json)
    expect_json("192.0.2.1" host)
    expect_json(3 sent)
    expect_json(2 received)
    expect_json(33 loss)
    expect_json(10 rtt min)
    expect_json(20 rtt avg)
    expect_json(30 rtt max)
    expect_json(20 rtt median)
    expect_json(10 rtt stddev)
    expect_json(20 rtt jitter)
elseif(CASE STREQUAL "mixed_csv")
    run_cli(0 3 192.0.2.1 -c 3 --summary --csv summary.csv)
    expect_text("${console}" "3 attempts, 2 replies, 33% without reply")
    file(STRINGS "${WORK_DIR}/summary.csv" csv)
    list(LENGTH csv row_count)
    if(NOT row_count EQUAL 2)
        message(FATAL_ERROR "Expected a CSV header and one row, got ${row_count}")
    endif()
    list(GET csv 0 header)
    list(GET csv 1 row)
    if(NOT header STREQUAL "host,sent,received,loss,min,avg,max,median,stddev,jitter"
            OR NOT row STREQUAL "192.0.2.1,3,2,33,10,20,30,20,10,20")
        message(FATAL_ERROR "Unexpected CSV:\n${header}\n${row}")
    endif()
elseif(CASE STREQUAL "retry_budget")
    run_cli(1 3 192.0.2.2 -r 3 --json summary.json)
    file(READ "${WORK_DIR}/summary.json" json)
    expect_json(3 sent)
    expect_json(0 received)
    expect_json(100 loss)
    foreach(metric IN ITEMS min avg max median stddev jitter)
        expect_json(0 rtt ${metric})
    endforeach()
    run_cli(1 3 192.0.2.2 -r 3 --summary)
    expect_text("${console}" "3 attempts, 0 replies, 100% without reply")
    reject_text("${console}" "rtt min/")
elseif(CASE STREQUAL "count_precedence")
    run_cli(0 3 192.0.2.1 -c 3 -r 5 --quiet)
    reject_text("${console}" "Attempt 1")
    expect_text("${console}" "RTT=10ms TTL=61")
    run_cli(0 3 192.0.2.1 -r 5 -c 3 --quiet)
    expect_text("${console}" "RTT=10ms TTL=61")
elseif(CASE STREQUAL "continuous_summary")
    run_cli(0 3 192.0.2.1 --continuous -c 3 -r 5 --interval 1 --quiet)
    expect_text("${console}" "3 attempts, 2 replies, 33% without reply")
    reject_text("${console}" "RTT=")
    reject_text("${console}" "Fixture timeout")
elseif(CASE STREQUAL "continuous_no_reply")
    run_cli(1 3 192.0.2.2 --continuous -c 3 --interval 1)
    expect_text("${console}" "3 attempts, 0 replies, 100% without reply")
    reject_text("${console}" "rtt min/")
elseif(CASE STREQUAL "continuous_interrupted")
    run_cli(0 2 192.0.2.5 --continuous -r 1 --interval 1 --json summary.json)
    file(READ "${WORK_DIR}/summary.json" json)
    expect_json(2 sent)
    expect_json(1 received)
    expect_json(50 loss)
    expect_json(14 rtt min)
elseif(CASE STREQUAL "temporal_jitter")
    run_cli(0 3 192.0.2.3 -r 3 --summary --json summary.json)
    file(READ "${WORK_DIR}/summary.json" json)
    expect_json(3 received)
    expect_json(20 rtt median)
    expect_json(15 rtt jitter)
elseif(CASE STREQUAL "failed_export")
    file(MAKE_DIRECTORY "${WORK_DIR}/directory")
    run_cli(1 1 192.0.2.4 --json directory)
    expect_text("${errors}" "could not write summary to directory")
else()
    message(FATAL_ERROR "Unknown regression case '${CASE}'")
endif()
